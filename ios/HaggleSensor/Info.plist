<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Camera permission (required for Presage & QR scanning) -->
  <key>NSCameraUsageDescription</key>
  <string>Haggle needs camera access to scan the session QR and measure biometrics.</string>

  <!-- Enable deep link from the web QR: haggle://&lt;sessionId&gt; -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.tamuhack26.haggle</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>haggle</string>
      </array>
    </dict>
  </array>
</dict>
</plist>

