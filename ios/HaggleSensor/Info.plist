<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Camera permission (required for Presage & QR scanning) -->
  <key>NSCameraUsageDescription</key>
  <string>Haggle needs camera access to scan the session QR and measure biometrics.</string>

  <!-- Enable deep link from the web QR: haggle://&lt;sessionId&gt; -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.tamuhack26.haggle</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>haggle</string>
      </array>
    </dict>
  </array>

  <!-- Launch Screen Configuration (CRITICAL: Removes black bars) -->
  <key>UILaunchScreen</key>
  <dict>
    <key>UIColorName</key>
    <string></string>
    <key>UIImageName</key>
    <string></string>
    <key>UILaunchScreen</key>
    <dict/>
  </dict>

  <!-- Declare support for all device capabilities -->
  <key>UIRequiredDeviceCapabilities</key>
  <array>
    <string>arm64</string>
  </array>

  <!-- Support all interface orientations (or restrict as needed) -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <!-- iPhone-only (remove iPad letterboxing potential) -->
  <key>UIDeviceFamily</key>
  <array>
    <integer>1</integer>
  </array>
</dict>
</plist>

